// Tang Nano 9K (GW1NR-LV9 QN88P) pin atamaları
// Sistem saati 27 MHz
IO_LOC "clk" 52;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// S1 butonu = sistem reset (aktif düşük)
IO_LOC "resetn" 3;
IO_PORT "resetn" IO_TYPE=LVCMOS18 PULL_MODE=UP;

// S2 butonu = kullanıcı butonu (test programları)
IO_LOC "btn_user" 4;
IO_PORT "btn_user" IO_TYPE=LVCMOS18 PULL_MODE=UP;

// BL616 USB-UART köprüsü (board üstü)
//   FPGA RX  <- BL616 TX  (Pin 18)
//   FPGA TX  -> BL616 RX  (Pin 17)
IO_LOC "uart_rx" 18;
IO_PORT "uart_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "uart_tx" 17;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;

// 6 LED bankı (aktif düşük) - Pin 10..15
IO_LOC "led[0]" 10;
IO_LOC "led[1]" 11;
IO_LOC "led[2]" 13;
IO_LOC "led[3]" 14;
IO_LOC "led[4]" 15;
IO_LOC "led[5]" 16;
IO_PORT "led[0]" IO_TYPE=LVCMOS18 PULL_MODE=UP DRIVE=8;
IO_PORT "led[1]" IO_TYPE=LVCMOS18 PULL_MODE=UP DRIVE=8;
IO_PORT "led[2]" IO_TYPE=LVCMOS18 PULL_MODE=UP DRIVE=8;
IO_PORT "led[3]" IO_TYPE=LVCMOS18 PULL_MODE=UP DRIVE=8;
IO_PORT "led[4]" IO_TYPE=LVCMOS18 PULL_MODE=UP DRIVE=8;
IO_PORT "led[5]" IO_TYPE=LVCMOS18 PULL_MODE=UP DRIVE=8;
